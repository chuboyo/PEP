DATABASE_URL=postgresql+psycopg://pep:pep@db:5432/pep
TEST_DATABASE_URL=postgresql+psycopg://pep:pep@db:5432/pep_test
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
SUPERADMIN_EMAIL=superadmin@example.com
# Leave empty and pass interactively, or set a strong password (min 12 chars).
# Not applied by API startup unless SEED_SUPERADMIN_ON_STARTUP=true.
SUPERADMIN_PASSWORD=
# Prefer false; create the first admin with:
#   docker compose run --rm api python -m scripts.create_superadmin
SEED_SUPERADMIN_ON_STARTUP=false
POSTGRES_USER=pep
POSTGRES_PASSWORD=pep
POSTGRES_DB=pep
